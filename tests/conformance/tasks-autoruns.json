        { "hive": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run", "name": "Helper", "value": "C:\\Program Files\\Help Desk\\helper.exe /min", "image_path": "C:\\Program Files\\Help Desk\\helper.exe", "image_dir": "C:\\Program Files\\Help Desk" }
