        { "name": "AdminsGroup", "path": "\\", "state": "Ready", "run_as": null, "run_as_sid": null, "run_as_group": "Administrators", "run_as_group_sid": "S-1-5-32-544", "run_level": "Highest",
          "actions": { "execute": "C:\\Shared\\job.exe", "arguments": null, "image_path": "C:\\Shared\\job.exe", "image_dir": "C:\\Shared" } },
        { "name": "ElevatedSelf", "path": "\\", "state": "Ready", "run_as": "alice", "run_as_sid": "S-1-5-21-1-2-3-1001", "run_as_group": null, "run_as_group_sid": null, "run_level": "Highest",
