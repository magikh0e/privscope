        { "sid": "S-1-5-32-545", "name": "BUILTIN\\Users" }
      ],
      "privileges": []
    },
    "facts": {
      "scheduled_tasks": [
        { "name": "Updater", "path": "\\Vendor\\", "state": "Ready", "run_as": "SYSTEM", "run_as_sid": "S-1-5-18", "run_as_group": null, "run_as_group_sid": null, "run_level": "Limited",
          "actions": [ { "execute": "C:\\Vendor\\upd.exe", "arguments": null, "image_path": "C:\\Vendor\\upd.exe", "image_dir": "C:\\Vendor" } ] },
